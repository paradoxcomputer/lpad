    {
      "name": "wlez",
      "description": "Wraps the native LEZ balance into a token so it can be used as collateral.",
      "program_id": "cce98686cad26bfc7c1e53a8eb99c856939985a9bbb9d030052cbaf9588e0227",
      "program_id_words": [
        2256988620,
        4234924746,
        2824019580,
        1455987179,
        2844105107,
        818985403,
        4189727749,
        654478936
      ],
      "instruction_type": "wlez_core::Instruction",
      "instructions": [
        {
          "name": "initialize",
          "variant": "Initialize",
          "discriminant": 0,
          "docs": [
            "One-shot setup: claim the WLEZ vault PDA and create the WLEZ token definition via a chained token::NewFungibleDefinition.",
            "Idempotent - re-running is a no-op (vault already claimed, definition already owned by the token program)."
          ],
          "accounts": [
            {
              "name": "vault",
              "index": 0
            },
            {
              "name": "definition",
              "index": 1
            },
            {
              "name": "init_holding",
              "index": 2
            },
            {
              "name": "reference_token_def",
              "index": 3
            },
            {
              "name": "payer",
              "index": 4
            }
          ],
          "args": [
            {
              "name": "token_program_id",
              "type": "ProgramId"
            },
            {
              "name": "native_program_id",
              "type": "ProgramId"
            }
          ]
        },
        {
          "name": "wrap",
          "variant": "Wrap",
          "discriminant": 1,
          "docs": [
            "Lock `amount` native LEZ into the vault and mint `amount` WLEZ to the user's holding.",
            "The native leg is a chained authenticated_transfer::Transfer, dispatched to the native program id recorded in the vault's data at Initialize.",
            "The mint authority is supplied by this program via with_pda_seeds(wlez_definition_seed) on the chained token::Mint."
          ],
          "accounts": [
            {
              "name": "user_native",
              "index": 0
            },
            {
              "name": "vault",
              "index": 1
            },
            {
              "name": "definition",
              "index": 2
            },
            {
              "name": "user_holding",
              "index": 3
            }
          ],
          "args": [
            {
              "name": "amount",
              "type": "u128"
            }
          ]
        },
        {
          "name": "unwrap",
          "variant": "Unwrap",
          "discriminant": 2,
          "docs": [
            "Burn `amount` WLEZ from the user's holding and release `amount` native LEZ from the vault.",
            "The burn is authorised by the user's signature on user_holding; the native release is performed by WLEZ mutating the vault and user_native balances directly in its own post-states (it is both the executing program and the vault owner), so there is no chained native transfer."
          ],
          "accounts": [
            {
              "name": "user_holding",
              "index": 0
            },
            {
              "name": "definition",
              "index": 1
            },
            {
              "name": "vault",
              "index": 2
            },
            {
              "name": "user_native",
              "index": 3
            }
          ],
          "args": [
            {
              "name": "amount",
              "type": "u128"
            }
          ]
        }
      ],
      "account_types": [
        {
          "name": "VaultData",
          "docs": [
            "The vault's `data` holds the canonical native (authenticated-transfer) program id as 32 little-endian bytes, written once at Initialize and read back by every Wrap to pin the native-transfer leg.",
            "See wlez_core::encode_program_id / decode_program_id."
          ],
          "type": {
            "kind": "struct",
            "fields": [
              {
                "name": "native_program_id",
                "type": {
                  "array": [
                    "u8",
                    32
                  ]
                }
              }
            ]
          }
        }
      ]
    },
